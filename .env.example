# --- Google Service Account (Drive + Sheets) ---
# Create a Service Account in Google Cloud Console, enable the Drive API and
# Sheets API, and download its JSON key. Copy the two fields below from it.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private_key value exactly, keeping \n as literal characters.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExampleKeyContent\n-----END PRIVATE KEY-----\n"

# Optional. Use this ONLY if your Google Workspace admin has enabled
# Domain-Wide Delegation for the service account and you want uploads to run
# as a real Workspace user. Leave blank when uploading to a Shared Drive that
# the service account can access directly.
GOOGLE_IMPERSONATED_USER_EMAIL=

# IMPORTANT FOR SERVICE-ACCOUNT UPLOADS:
# Prefer a folder inside a Google Workspace Shared Drive. Add the service
# account as a Content manager/member of that Shared Drive, then paste the
# destination folder ID here. Service accounts do not have personal Drive
# storage quota, so a normal personal My Drive folder is not a reliable upload
# target unless you use Domain-Wide Delegation above.
GOOGLE_DRIVE_PARENT_FOLDER_ID=shared_drive_folder_id_here

# Create a Google Sheet with tabs "Guests" (A:D) and "Uploads" (A:H),
# share it with the same service account email (Editor), paste its ID here.
GOOGLE_SHEETS_ID=sheet_id_here

# Random long string used to sign upload session tokens. Generate one with:
#   openssl rand -hex 32
UPLOAD_TOKEN_SECRET=replace_with_a_long_random_string

# Your deployed site URL (used for origin/CSRF checks and QR code target).
SITE_URL=https://your-wedding-site.vercel.app
